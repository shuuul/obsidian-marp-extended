{
	"name": "marp-extended",
	"version": "0.10.0-beta.1",
	"description": "Create markdown-based Marp presentations in Obsidian with extended Marp support",
	"main": "main.js",
	"scripts": {
		"postinstall": "node scripts/postinstall.mjs",
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"test": "node scripts/run-jest.js",
		"test:watch": "node scripts/run-jest.js --watch",
		"test:coverage": "node scripts/run-jest.js --coverage",
		"obsidian:reload": "node scripts/reload-obsidian-plugin.mjs",
		"obsidian:profile": "node scripts/profile-obsidian-plugin.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"version:beta": "node scripts/prepare-beta-release.cjs",
		"typecheck": "node node_modules/typescript-native/bin/tsc --noEmit --skipLibCheck",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "npm run lint -- --fix",
		"check:specs": "node scripts/check-specs.mjs",
		"scan:release": "node scripts/scan-release-assets.mjs",
		"analyze:bundle": "npm run typecheck && node esbuild.config.mjs production --analyze",
		"sync:themes": "node scripts/sync-packaged-themes.mjs"
	},
	"keywords": [],
	"author": "shuuul",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.2.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.9.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"obsidian": "^1.13.1",
		"semver": "^7.8.5",
		"ts-jest": "^29.4.12",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.67.0",
		"typescript-native": "npm:typescript@^7.0.2"
	},
	"dependencies": {
		"@marp-team/marp-core": "5.0.1",
		"@mathjax/mathjax-bbm-font-extension": "^4.1.3",
		"@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
		"@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
		"@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
		"@mathjax/src": "^4.1.3",
		"beautiful-mermaid": "^1.1.3",
		"shiki": "^4.4.3"
	},
	"marpExtended": {
		"npxMarpCliPackage": "@marp-team/marp-cli@4.5.0"
	},
	"engines": {
		"node": ">=20.19"
	}
}
