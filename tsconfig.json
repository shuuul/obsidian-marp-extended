{
  "compilerOptions": {
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test/*": [
        "./tests/*"
      ],
      "@marp-extended/code-fence-scanner": [
        "./packages/code-fence-scanner/src/index.ts"
      ],
      "@marp-extended/marp-dsl": [
        "./packages/marp-dsl/src/index.ts"
      ],
      "@marp-extended/wiki-links": [
        "./packages/wiki-links/src/index.ts"
      ],
      "@marp-extended/mermaid-autofit": [
        "./packages/mermaid-autofit/src/index.ts"
      ]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest"
    ],
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts"
  ]
}
